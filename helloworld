# hedef exe listesini belirle
exe_list = []

if os.path.isfile(target_file):
    exe_list = [target_file]
else:
    if os.path.isdir(target_dir):
        for f in os.listdir(target_dir):
            full = os.path.join(target_dir, f)
            if f.lower().endswith(".exe"):
