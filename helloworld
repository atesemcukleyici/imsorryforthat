# once calisan tum sppsvc processlerini oldur
try:
    ps_cmd = "Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'sppsvc.exe' } | Select-Object -ExpandProperty ProcessId"
    result = subprocess.run(
        ["powershell", "-NoProfile", "-Command", ps_cmd],
        capture_output=True, text=True, encoding="utf-8", errors="replace", creationflags=subprocess.CREATE_NO_WINDOW
    )
    pids = [l.strip() for l in result.stdout.strip().splitlines() if l.strip()]
    if pids:
        killed = []
        for pid in pids:
            try:
                subprocess.run(
                    ["taskkill", "/F", "/PID", pid],
                    capture_output=True, text=True, encoding="utf-8", errors="replace", creationflags=subprocess.CREATE_NO_WINDOW
                )
                killed.append(pid)
            except Exception:
                pass
        send("🔪 Process Temizligi", f"calisan: {', '.join(pids)}\nolduruldu: {', '.join(killed)}", YELLOW)
    else:
        send("🔪 Process Temizligi", "calisan sppsvc process yok, temiz.", GREEN)
except Exception as e:
    send("❌ Process Kill Hatasi", str(e), RED)

